# ==========================================================
#  CRM + Savdo tizimi — Environment o'zgaruvchilari (NAMUNA)
# ----------------------------------------------------------
#  1) Ushbu faylni nusxalang:  cp .env.example .env
#  2) .env ichidagi qiymatlarni o'zingiznikiga almashtiring
#  3) .env HECH QACHON git'ga qo'shilmaydi (.gitignore'da bo'lsin!)
# ==========================================================

# ----------------------------------------------------------
# DJANGO — asosiy sozlamalar
# ----------------------------------------------------------
# Yangi kalit: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# Hozirgi struktura: root.settings (reja bo'yicha refaktordan keyin: config.settings.local)
DJANGO_SETTINGS_MODULE=root.settings
# Vergul bilan ajratiladi. Prod'da hech qachon "*" qo'ymang!
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# HTTPS ortida turganda (nginx/traefik) prod'da True qiling
SECURE_SSL_REDIRECT=False

LANGUAGE_CODE=uz
TIME_ZONE=Asia/Tashkent

# ----------------------------------------------------------
# DATABASE — PostgreSQL 16
# ----------------------------------------------------------
POSTGRES_DB=crm_db
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=
# Docker compose'da: db  |  lokal o'rnatilganda: 127.0.0.1
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Ixtiyoriy: yuqoridagilar o'rniga bitta URL bilan ham ulanish mumkin
# DATABASE_URL=postgres://crm_user:parol@127.0.0.1:5432/crm_db
DB_CONN_MAX_AGE=60

# ----------------------------------------------------------
# JWT (djangorestframework-simplejwt)
# ----------------------------------------------------------
# Daqiqalarda
ACCESS_TOKEN_LIFETIME_MINUTES=30
# Kunlarda
REFRESH_TOKEN_LIFETIME_DAYS=7
ROTATE_REFRESH_TOKENS=True
BLACKLIST_AFTER_ROTATION=True
# Bo'sh qoldirilsa DJANGO_SECRET_KEY ishlatiladi
JWT_SIGNING_KEY=

# ----------------------------------------------------------
# REDIS — cache + Celery broker
# ----------------------------------------------------------
# Docker compose'da: redis  |  lokal: 127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_DB=1
CELERY_BROKER_DB=0
CELERY_RESULT_DB=2
# To'liq URL berilsa yuqoridagilardan ustun turadi
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
# True bo'lsa task'lar navbatsiz, darhol bajariladi (test uchun qulay)
CELERY_TASK_ALWAYS_EAGER=False
# Statistika endpointlari cache TTL (sekund) — rejada 5 daqiqa
ANALYTICS_CACHE_TTL=300

# ----------------------------------------------------------
# TELEGRAM BOT (aiogram 3) — tasdiqlash kodi shu orqali yuboriladi
# ----------------------------------------------------------
# @BotFather dan olinadi
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# polling | webhook  (rejada: polling)
TELEGRAM_BOT_MODE=polling
# webhook rejimida kerak bo'ladi
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Xatoliklar yuboriladigan admin chat ID (ixtiyoriy)
TELEGRAM_ADMIN_CHAT_ID=

# ----------------------------------------------------------
# VERIFICATION CODE — ro'yxatdan o'tish / parol tiklash kodi
# ----------------------------------------------------------
VERIFICATION_CODE_LENGTH=6
# Kod amal qilish muddati (daqiqa)
VERIFICATION_CODE_TTL_MINUTES=5
# Necha marta noto'g'ri kiritish mumkin
VERIFICATION_CODE_MAX_ATTEMPTS=3
# Qayta kod so'rash oralig'i (sekund)
VERIFICATION_CODE_RESEND_SECONDS=60

# ----------------------------------------------------------
# CORS / CSRF — frontend va mobile uchun
# ----------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Faqat dev uchun True. Prod'da MAJBURIY False!
CORS_ALLOW_ALL_ORIGINS=False

# ----------------------------------------------------------
# THROTTLING (DRF) — 429 uchun
# ----------------------------------------------------------
THROTTLE_ANON=100/hour
THROTTLE_USER=1000/hour
# Kod yuborish/tasdiqlash endpointlari uchun
THROTTLE_AUTH=10/hour

# ----------------------------------------------------------
# EMAIL (ixtiyoriy — xabarnoma / xatolik hisobotlari uchun)
# ----------------------------------------------------------
# dev: django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CRM <no-reply@example.com>

# ----------------------------------------------------------
# MEDIA / STATIC — dev: local, prod: S3 yoki MinIO
# ----------------------------------------------------------
STATIC_URL=/static/
MEDIA_URL=/media/
# local | s3
FILE_STORAGE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
# MinIO ishlatilsa: http://127.0.0.1:9000
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
# Rasm yuklash cheklovi (MB)
MAX_UPLOAD_SIZE_MB=5

# ----------------------------------------------------------
# SUPERUSER — birinchi admin (docker entrypoint/seed uchun)
# ----------------------------------------------------------
DJANGO_SUPERUSER_PHONE=+998901234567
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

# ----------------------------------------------------------
# MONITORING (bonus)
# ----------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0
